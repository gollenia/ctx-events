{
	"$schema": "https://www.schemastore.org/package.json",
	"version": "0.1.4",
	"name": "ctx-events",
	"description": "A WordPress plugin to manage events.",
	"author": {
		"email": "thomas@kids-team.at",
		"name": "Thomas Gollenia"
	},
	"license": "GPL-3.0",
	"scripts": {
		"ts:generate": "php bin/typescript-transformer.php",
		"build": "wp-scripts build --config webpack.config.js",
		"start": "npm run ts:generate && wp-scripts start --config webpack.config.js",
		"test:e2e": "playwright test",
		"make-pot": "wp i18n make-pot . languages/ctx-events.pot --slug=ctx-events --domain=ctx-events --exclude=node_modules,src",
		"make-json": "wp i18n make-json languages/ --no-purge",
		"packages-update": "wp-scripts packages-update"
	},
	"overrides": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@contexis/use-api-fetch": "^1.0.4",
		"@contexis/wp-react-form": "^2.6.2",
		"@tiptap/extension-bubble-menu": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/react": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"@wordpress/api-fetch": "^7.54.0",
		"@wordpress/icons": "^15.5.0",
		"clsx": "^2.1.1",
		"uuid": "^14.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@playwright/test": "^1.58.2",
		"@types/wordpress__block-editor": "^15.0.6",
		"@types/wordpress__blocks": "^15.10.0",
		"@types/wordpress__components": "^23.0.12",
		"@types/wordpress__core-data": "^2.4.5",
		"@types/wordpress__data": "^6.0.2",
		"@types/wordpress__editor": "^14.3.1",
		"@wordpress/interactivity": "^6.40.0",
		"@wordpress/scripts": "^34.2.0"
	}
}
