{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"name": "ctx-events/booking",
	"apiVersion": 3,
	"title": "Event Booking",
	"description": "Add a button that allows the user to book tickets for an event.",
	"category": "widgets",
	"attributes": {
		"buttonTitle": {
			"type": "string",
			"default": ""
		},
		"buttonIcon": {
			"type": "string",
			"default": ""
		},
		"iconRight": {
			"type": "boolean",
			"default": false
		},
		"iconOnly": {
			"type": "boolean",
			"default": false
		}
	},
	"usesContext": ["postType"],
	"supports": {
		"anchor": true,
		"html": false,
		"spacing": {
			"margin": true
		}
	},
	"styles": [
		{
			"name": "fill",
			"label": "Fill",
			"isDefault": true
		},
		{
			"name": "outline",
			"label": "Outline"
		},
		{
			"name": "link",
			"label": "Link"
		}
	],
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view/index.js"
}
