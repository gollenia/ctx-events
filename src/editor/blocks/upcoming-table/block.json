{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"name": "ctx-events/events-table",
	"title": "Events Table",
	"description": "Shows upcoming events in a table",
	"apiVersion": 3,
	"category": "widgets",
	"attributes": {
		"showCategory": { "type": "boolean", "default": true },
		"showLocation": { "type": "string", "default": "" },
		"filterPosition": { "type": "string", "default": "top" },
		"tableShowHeader": { "type": "boolean", "default": false },
		"tableShowDividers": { "type": "boolean", "default": true },
		"tableAlternatingRows": { "type": "boolean", "default": false },
		"tableHoverEffect": { "type": "boolean", "default": true },
		"tableShowCalendarIcon": { "type": "boolean", "default": false },
		"tableColumns": {
			"type": "array",
			"default": ["title", "category", "description", "booking"]
		},
		"limit": { "type": "number", "default": 99 },
		"order": { "type": "string", "default": "asc" },
		"selectedCategory": { "type": "array", "default": [] },
		"selectedLocation": { "type": "number", "default": 0 },
		"selectedTags": { "type": "array", "default": [] },
		"excerptLength": { "type": "number", "default": 20 },
		"showAudience": { "type": "boolean", "default": false },
		"showPerson": { "type": "string", "default": "" },
		"showCategoryFilter": { "type": "boolean", "default": false },
		"showTagFilter": { "type": "boolean", "default": false },
		"showSearch": { "type": "boolean", "default": false },
		"scope": { "type": "string", "default": "future" },
		"bookedUpWarningThreshold": { "type": "number", "default": 0 },
		"showBookedUp": { "type": "boolean", "default": true },
		"excludeCurrent": { "type": "boolean", "default": true },
		"includeRecurring": { "type": "boolean", "default": false },
		"altText": { "type": "string", "default": "" }
	},
	"supports": {
		"align": ["wide", "full"],
		"anchor": true,
		"spacing": {
			"margin": ["top", "bottom"],
			"padding": ["left", "right"],
			"blockGap": true,
			"__experimentalDefaultControls": { "padding": true, "blockGap": true }
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"editorStyle": "file:./index.css"
}
